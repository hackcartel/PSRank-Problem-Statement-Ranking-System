# Supabase browser credentials are public configuration; database access is enforced by RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Keep the Gemini API key private. It is passed only to the analyzer container.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# Local browser port for the Docker-hosted app.
APP_PORT=8080
